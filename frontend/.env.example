# Copy to .env.local if you need to change these. Only VITE_* variables reach the
# browser, so never put a secret here.

# Backend base URL. Leave empty in development: Vite proxies /api to localhost:3000.
# In production (Vercel), set it to the deployed backend, e.g. https://api.example.com
VITE_API_URL=

# Show the request/response JSON panel. It is always on in `npm run dev`.
VITE_SHOW_JSON=false

# Copy to .env and fill in. Never commit .env.
PORT=3000
# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resource_navigator
# Set to true for Supabase or any hosted database that requires TLS
DATABASE_SSL=false
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Signs admin session cookies. Required for /api/admin routes (min 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# AI providers (optional). Gemini is tried first, Groq if Gemini fails.
# With no keys, search uses PostgreSQL full-text matching and shows no explanations.
# Free tiers: Google may use free-tier Gemini requests to improve its products.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq key: https://console.groq.com/keys (model must support strict JSON schema output)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Timeout per AI call, per provider, in milliseconds
AI_TIMEOUT_MS=4000
